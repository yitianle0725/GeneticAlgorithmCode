{
  "name": "iemoeo_mechanisms_v2",
  "description": "schema 2：补齐代表选择、真实拥挤距离、无全局组合与局部预算转移对照；冒烟不证明性能贡献。",
  "variants": {
    "full": {
      "label": "当前完整 IE-MOEO",
      "arguments": []
    },
    "shared": {
      "label": "共享交配池，保留岛内更新",
      "arguments": [
        "--no-isolation"
      ]
    },
    "rank": {
      "label": "关闭参考方向维护，末层随机截断",
      "arguments": [
        "--no-diversity-maintenance"
      ]
    },
    "shared_rank": {
      "label": "共享交配池且关闭参考方向维护",
      "arguments": [
        "--no-isolation",
        "--no-diversity-maintenance"
      ]
    },
    "unchecked": {
      "label": "关闭邻域代表资格检查",
      "arguments": [
        "--no-parent-check"
      ]
    },
    "sbx": {
      "label": "组合阶段改用 SBX，保留变异与修复",
      "arguments": [
        "--combination-method",
        "sbx_only"
      ]
    },
    "random_coord": {
      "label": "逐坐标继承，保留变异与修复",
      "arguments": [
        "--combination-method",
        "random_coord"
      ]
    },
    "shared_sbx": {
      "label": "共享交配池与 SBX 组合",
      "arguments": [
        "--no-isolation",
        "--combination-method",
        "sbx_only"
      ]
    },
    "radius_005": {
      "label": "资格检查半径 0.05",
      "arguments": [
        "--principle-probe-radius",
        "0.05"
      ]
    },
    "radius_02": {
      "label": "资格检查半径 0.2",
      "arguments": [
        "--principle-probe-radius",
        "0.2"
      ]
    },
    "radius_10": {
      "label": "资格检查半径 1.0，仅用于激活诊断",
      "arguments": [
        "--principle-probe-radius",
        "1.0"
      ]
    },
    "local_3": {
      "label": "每轮局部进化 3 代",
      "arguments": [
        "--inner-generations-early",
        "3",
        "--inner-generations-late",
        "3"
      ]
    },
    "local_5": {
      "label": "每轮局部进化 5 代",
      "arguments": [
        "--inner-generations-early",
        "5",
        "--inner-generations-late",
        "5"
      ]
    },
    "uniform_2": {
      "label": "均匀划分两块",
      "arguments": [
        "--block-size",
        "2"
      ]
    },
    "known_2": {
      "label": "位置/距离两块，不宣称完全可分",
      "arguments": [
        "--block-size",
        "2",
        "--block-mode",
        "known_separable"
      ]
    },
    "representatives_only": {
      "label": "移除非代表局部个体候选池",
      "arguments": [
        "--no-elitist-pool"
      ]
    },
    "local_random": {
      "label": "每个非空岛随机选一个代表",
      "arguments": [
        "--representative-selection",
        "local_random"
      ]
    },
    "global_best": {
      "label": "联合局部池按标量适应度选相同数量代表槽位",
      "arguments": [
        "--representative-selection",
        "global_best"
      ]
    },
    "crowding": {
      "label": "真实 NSGA-II 拥挤距离的环境选择",
      "arguments": [
        "--iemoeo-survival",
        "rank_crowding"
      ]
    },
    "shared_crowding": {
      "label": "共享交配加真实拥挤距离",
      "arguments": [
        "--no-isolation",
        "--iemoeo-survival",
        "rank_crowding"
      ]
    },
    "no_combination": {
      "label": "关闭全局组合，名义组合 FE 转给局部搜索",
      "arguments": [
        "--combination-method",
        "none"
      ]
    },
    "shared_no_combination": {
      "label": "共享交配并关闭全局组合，预算转给局部搜索",
      "arguments": [
        "--no-isolation",
        "--combination-method",
        "none"
      ]
    }
  },
