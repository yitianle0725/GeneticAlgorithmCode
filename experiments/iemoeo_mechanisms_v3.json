  "pending_controls": [
    {
      "id": "island_parallelism",
      "required_for": "岛内并行效率更高",
      "reason": "--workers 仅并行独立实验任务，不是岛内并行；需固定硬件和 FE 的 1/2/4/8 核加速及通信开销实验"
