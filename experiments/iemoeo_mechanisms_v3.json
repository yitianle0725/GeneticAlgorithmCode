    }
  ],
  "common_arguments": [
    "--iemoeo-selection-audit"
  ],
  "implemented_controls": [
    {
      "id": "local_representative_selection",
      "required_for": "局部竞争所得亲本优于随机或全局高适应度亲本",
      "reason": "目前 --no-parent-check 只移除邻域资格检查，未移除局部最佳代表选择；需等 FE 的岛内随机代表和全局标量最佳代表控制",
      "status": "implemented_not_confirmed"
    },
    {
      "id": "true_crowding_control",
      "required_for": "独立进化可替代拥挤距离",
      "reason": "当前 rank 对照是随机截断而非拥挤距离；需隔离开关×真实 rank-and-crowding 的同一核心控制，并追踪目标近似但决策远离的个体",
      "status": "implemented_not_confirmed"
    },
    {
      "id": "no_combination_equal_budget",
      "required_for": "跨岛组合本身优于无组合",
      "reason": "SBX 仍是跨亲本重组；需关闭组合并明确把相同 FE 重新分配到局部进化的策略",
      "status": "implemented_not_confirmed"
    }
  ],
  "budget_policy": {
    "none": "每轮用 min(亲本索引对数,组合上限,剩余FE) 作为名义额度，转给原交配规则的局部搜索并逐次限制新评价数；完整版本缓存命中可能使实际组合FE低于名义额度。总FE相同，不宣称各阶段实际FE精确相同。"
  },
  "selection_audit_policy": {
    "objective_rms_threshold": 0.02,
    "decision_rms_threshold": 0.2,
    "max_pairs_per_round": 1024,
    "interpretation": "固定独立随机流抽样的候选对保留描述；不能把未保留自动视为错杀，也不能代替性能证据。"
  },
  "hypothesis_policy": {
    "core": "Use all six registered problems and M3/4/10; report both IGD+ and HV with joint Holm correction. Independent confirmation uses seeds31-60 and 400N.",
    "parents": "Two preregistered RMS radii; compare each check-on arm only with its matched check-off control. Require an actual parent-pool change before interpreting performance effects.",
    "blocks": "Position/distance grouping is problem-informed, not a proof of separability. Compare matched block sizes against shuffled coordinates and compare identical configs with SBX/per-coordinate inheritance.",
    "development": "Pilot seeds6-15 are for development. Freeze the chosen algorithm/configuration before confirmation; never select a winning arm on confirmation seeds.",
    "negative_results": "Keep all negative scenes. No requirement that the check or blocks must win; drop unhelpful mechanisms if supported by development evidence.",
    "timing": "Disable selection diagnostics and run one worker. Task workers do not measure island-level speedup."
  }
}
