digraph IEMOEC_framework {
	bgcolor=white compound=true dpi=72.0 fontname=Helvetica fontsize=9.5 margin=0 newrank=true nodesep=0.115 outputorder=edgesfirst pad=0 rankdir=TB ranksep=0.02 splines=ortho
	node [color="#2F3437" fontcolor="#2F3437" fontname=Helvetica fontsize=9.5 height=0.30 margin="0.05,0.035" penwidth=0.9]
	edge [arrowsize=0.58 color="#2F3437" fontcolor="#2F3437" fontname=Helvetica fontsize=9 penwidth=0.9]
	start [label=Start fillcolor=white shape=ellipse style=filled]
	initialize [label="Initialize P_o
Evaluate
A <- P_o" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
	subgraph cluster_independent {
		color="#2F3437" fontname="Helvetica-Bold" fontsize=9.5 label="1  INDEPENDENT
SUBPOPULATION
EVOLUTION" labeljust=l labelloc=t margin=4 penwidth=1.1 style=rounded
		phase [label="Phase control
FE ratio
< 0.40?" color="#557A95" fillcolor="#DDEAF2" margin=0.02 penwidth=1.15 shape=diamond style=filled]
		build_islands [label="Periodic multi-ancestor
construction from A (0 FE)" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		island_bank [label="{2M ISLANDS|{M axial|M random}|direction elite + neighbors|+ diverse solutions}" color="#2F3437" fillcolor="#F4F5F6" penwidth=1.0 shape=record style=filled]
		local_evolution [label="Independent SBX + PM
Evaluate
TCH / Pareto survival" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		phase -> build_islands [style=invis weight=5]
		build_islands -> island_bank
		island_bank -> local_evolution
		phase -> local_evolution [color="#6B7074" constraint=false fontcolor="#6B7074" style=dotted]
	}
	subgraph cluster_combination {
		color="#6B7074" fontname="Helvetica-Bold" fontsize=9.5 label="2  CROSS-ISLAND
EXTREMA
COMBINATION" labeljust=l labelloc=t margin=4 penwidth=1.1 style="rounded,dashed"
		extrema [label="One weighted
extremum per island" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		pairing [label="Least-similar direction
pairing" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		combination_offspring [label="SBX + PM + evaluation
Q_c; budget 1.0 / 0.25" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		extrema -> pairing
		pairing -> combination_offspring
	}
	subgraph cluster_global {
		color="#557A95" fontname="Helvetica-Bold" fontsize=9.5 label="3  GLOBAL
REFERENCE-DIRECTION
SELECTION" labeljust=l labelloc=t margin=4 penwidth=1.1 style=rounded
		merge [label="Merge
A + P_o
+ islands + Q_c" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		archive_selection [label="NSGA-III survival
A <- select N" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		origin_selection [label="NSGA-III survival
P_o <- select origins" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		termination [label="MaxFEs
reached?" color="#2F3437" fillcolor=white margin=0.02 shape=diamond style=filled]
		final_population [label="Final NSGA-III survival
Return population" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		merge -> archive_selection
		archive_selection -> origin_selection
		origin_selection -> termination
		termination -> final_population [minlen=2 xlabel=YES]
	}
	start -> initialize
	{
		rank=same
		initialize
		build_islands
		extrema
		merge
	}
	initialize -> build_islands [constraint=false]
	phase -> combination_offspring [color="#6B7074" constraint=false fontcolor="#6B7074" style=dotted]
	local_evolution -> extrema
	local_evolution -> merge [constraint=false]
	combination_offspring -> merge
	termination -> build_islands [color="#557A95" constraint=false fontcolor="#557A95" penwidth=1.15 style=dashed xlabel=NO]
	fontcolor="#6B7074" fontsize=9 label="LEGEND   solid: candidate flow   |   dotted: phase control   |   dashed: outer-loop feedback" labeljust=c labelloc=b
}
