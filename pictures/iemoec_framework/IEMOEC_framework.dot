digraph IEMOEC_framework {
	bgcolor=white compound=true dpi=72.45 fontname=Helvetica fontsize=10 margin=0 newrank=true nodesep=0.22 outputorder=edgesfirst pad=0.08 rankdir=LR ranksep=0.42 size="7.16,4.15!" splines=ortho
	node [color="#2F3437" fontcolor="#2F3437" fontname=Helvetica fontsize=9.5 height=0.34 margin="0.08,0.05" penwidth=0.9]
	edge [arrowsize=0.62 color="#2F3437" fontcolor="#2F3437" fontname=Helvetica fontsize=8.5 penwidth=0.9]
	start [label=Start fillcolor=white shape=ellipse style=filled]
	initialize [label="Initialize origin population P_o
Float random sampling + evaluation
A <- P_o" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
	subgraph cluster_independent {
		color="#2F3437" fontname="Helvetica-Bold" fontsize=10 label="1  INDEPENDENT SUBPOPULATION EVOLUTION" labeljust=l labelloc=t margin=10 penwidth=1.1 style=rounded
		phase_check [label="FE / MaxFEs
< 0.40?" color="#557A95" fillcolor="#DDEAF2" margin=0.03 penwidth=1.15 shape=diamond style=filled]
		aggregation [label="YES - Aggregation Phase
Tchebycheff local survival
recombination ratio = 1.0" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		pareto [label="NO - Pareto Phase
nondominated fronts + weight tie-break
recombination ratio = 0.25" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		define_islands [label="Build 2M independent islands each round
M axial weights + M random aggregation weights
select one origin ancestor per island" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		expand [label="Single-ancestor island expansion
clone selected origin + Polynomial Mutation
evaluate mutated copies" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		island_bank [label="{2M ISLANDS (representative view)|{Island 1|Island 2|...|Island 2M}}" color="#2F3437" fillcolor="#F4F5F6" penwidth=1.0 shape=record style=filled]
		local_evolution [label="Independent evolution in every island
one generation: random pairing -> SBX -> Polynomial Mutation
evaluation -> phase-specific local survival" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		{
			rank=same
			phase_check
			aggregation
			pareto
		}
		{
			rank=same
			define_islands
			expand
			island_bank
			local_evolution
		}
		phase_check -> aggregation [color="#6B7074" constraint=false style=dotted]
		phase_check -> pareto [color="#6B7074" constraint=false style=dotted]
		aggregation -> define_islands [color="#6B7074" style=dotted]
		pareto -> define_islands [color="#6B7074" style=dotted]
		define_islands -> expand [constraint=false]
		expand -> island_bank [constraint=false]
		island_bank -> local_evolution [constraint=false]
	}
	subgraph cluster_combination {
		color="#6B7074" fontname="Helvetica-Bold" fontsize=10 label="2  CROSS-ISLAND EXTREMA COMBINATION" labeljust=l labelloc=t margin=10 penwidth=1.2 style="rounded,dashed"
		extract_extrema [label="Extract one local extremum per island
minimum weighted Tchebycheff score" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		direction_pairing [label="Pair extrema from least-similar
normalized weight directions
up to 2 partners per extremum" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		combination_offspring [label="Extrema Combination
SBX + Polynomial Mutation + evaluation
phase budget: 1.0 (Aggregation) / 0.25 (Pareto)" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		{
			rank=same
			extract_extrema
			direction_pairing
			combination_offspring
		}
		extract_extrema -> direction_pairing [constraint=false]
		direction_pairing -> combination_offspring [constraint=false]
	}
	subgraph cluster_global {
		color="#557A95" fontname="Helvetica-Bold" fontsize=10 label="3  GLOBAL REFERENCE-DIRECTION ENVIRONMENTAL SELECTION" labeljust=l labelloc=t margin=10 penwidth=1.5 style=rounded
		merge [label="Merge candidate solutions
A + P_o + all island populations
+ extrema-combination offspring" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		archive_selection [label="NSGA-III ReferenceDirectionSurvival
A <- global candidate pool (size N)" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		origin_selection [label="NSGA-III ReferenceDirectionSurvival
P_o <- select origin from A
|P_o| = min(N, max(20, ceil(0.2N)))" color="#557A95" fillcolor="#DDEAF2" penwidth=1.15 shape=box style="rounded,filled"]
		termination [label="MaxFEs reached?
NO: next outer iteration" color="#2F3437" fillcolor=white margin=0.03 shape=diamond style=filled]
		final_population [label="YES - Final reference-direction selection
Return final population" color="#2F3437" fillcolor=white penwidth=0.9 shape=box style="rounded,filled"]
		{
			rank=same
			merge
			archive_selection
			origin_selection
			termination
			final_population
		}
		merge -> archive_selection [constraint=false]
		archive_selection -> origin_selection [constraint=false]
		origin_selection -> termination [constraint=false]
		termination -> final_population [constraint=false]
	}
	{
		rank=same
		start
		initialize
	}
	start -> initialize [color="#6B7074" constraint=false style=dotted]
	initialize -> define_islands [constraint=false]
	initialize -> phase_check [color="#6B7074" constraint=false style=dotted]
	local_evolution -> extract_extrema
	local_evolution -> merge [constraint=false]
	combination_offspring -> merge
	termination -> phase_check [color="#557A95" constraint=false fontcolor="#557A95" penwidth=1.15 style=dashed]
	fontcolor="#6B7074" fontsize=8.5 label="LEGEND   solid arrow: candidate-solution flow   |   dotted arrow: phase/control signal   |   dashed arrow: outer-loop feedback" labeljust=c labelloc=b
}
